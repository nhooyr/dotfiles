[user]
	email = adam@qsnow.ca
	name = Adam Quinn Snow
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	verbose = true
	gpgsign = true
[rebase]
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[credential "https://*.googlesource.com"]
    helper = oauth

[fetch]
	prune = true
	followRemoteHEAD = always
[pull]
	ff = only
[push]
	autoSetupRemote = true
	recurseSubmodules = on-demand

[pager]
	log = diff-highlight-ws | $PAGER
	show = diff-highlight-ws | $PAGER
	diff = diff-highlight-ws | $PAGER
	grep = false
[interactive]
	diffFilter = diff-highlight-ws
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	tool = nvimdiff
	wsErrorHighlight = all
	colorMoved = blocks
	colorMovedWS = allow-indentation-change
	submodule = diff
[difftool]
	prompt = false
[color "decorate"]
	branch = blue italic ul
	remoteBranch = magenta italic ul
	tag = green italic ul
	stash = cyan italic ul
	head = cyan italic ul
[color "branch"]
	current = cyan bold
	upstream = magenta
	local = cyan
	remote = cyan
[color "diff"]
	commit = bold
	meta = magenta
	frag = magenta
	whitespace = white yellow
	oldMoved = red italic
	newMoved = green italic
[color "diff-highlight"]
	newHighlight = green reverse
	oldHighlight = red reverse
[color "blame"]
	repeatedLines = brightblack italic
[color "advice"]
	hint = brightblack italic
[color "interactive"]
	prompt = bold
	header = cyan bold
	help = brightblack italic
	error = yellow
[color "grep"]
	filename = cyan
	lineNumber = magenta
	column = magenta
	match = black brightyellow
	separator = normal
[blame]
	date = relative
	blankBoundary = true
	coloring = repeatedLines
[grep]
	lineNumber = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
