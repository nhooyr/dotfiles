[user]
	email = adam@qsnow.ca
	name = Adam Quinn Snow
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	verbose = true
	gpgsign = true
[rebase]
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate

[fetch]
	prune = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
	recurseSubmodules = on-demand

[pager]
	log = diff-highlight | less
	show = diff-highlight | less
	diff = diff-highlight | less
[interactive]
	diffFilter = diff-highlight
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	tool = nvimdiff
	wsErrorHighlight = all
	colorMoved = blocks
	colorMovedWS = allow-indentation-change
	submodule = diff
[difftool]
	prompt = false
[color "decorate"]
	branch = blue italic ul bold
	remoteBranch = cyan ul bold
	tag = magenta italic ul bold
	stash = magenta italic ul bold
	head = magenta ul bold
[color "branch"]
	current = blue italic bold
	upstream = cyan ul
	remote = magenta
[color "diff"]
	commit = cyan ul italic bold
	meta = magenta ul italic
	frag = magenta ul italic
	whitespace = white red
	oldMoved = red italic
	newMoved = green italic
[color "blame"]
	repeatedLines = magenta italic
[color "advice"]
	hint = cyan ul italic
[color "interactive"]
	prompt = bold
	header = italic bold
	help = cyan italic
	error = red bold ul
[color "grep"]
	filename = cyan
	lineNumber = normal italic
	column = normal italic
	match = white blue italic
	separator = normal
[blame]
	date = relative
	blankBoundary = true
	coloring = repeatedLines
[grep]
	lineNumber = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
