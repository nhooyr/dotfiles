[user]
	email = adam@qsnow.ca
	name = Adam Quinn Snow
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	verbose = true
	gpgsign = true
[rebase]
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate

[fetch]
	prune = true
	pruneTags = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
	recurseSubmodules = on-demand

[pager]
	log = diff-highlight | less
	show = diff-highlight | less
	diff = diff-highlight | less
[interactive]
	diffFilter = diff-highlight
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	tool = nvimdiff
	wsErrorHighlight = all
	colorMoved = default
	colorMovedWS = allow-indentation-change
	submodule = diff
[difftool]
	prompt = false
[color "diff"]
	meta = ul italic magenta
	frag = ul italic magenta
	whitespace = white red
	oldMoved = italic red
	newMoved = italic green
[blame]
	date = relative
	blankBoundary = true
	coloring = repeatedLines
[grep]
	lineNumber = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[advice]
	addEmptyPathspec = false
