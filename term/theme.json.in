{
    // Generated by term/generate.pl. Edit term/theme.json.in instead.
    // Reserve the Terminal palette's bright yellow (${brightYellow}) for search and selection
    // backgrounds with black text. Regular yellow (${yellow}) remains available for text.
    // The ANSI entries only define the palette.
    "$schema": "vscode://schemas/color-theme",
    "name": "nhooyr",
    "type": "light",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "${black}",
        "descriptionForeground": "${brightBlack}",
        "disabledForeground": "#767676",
        "errorForeground": "${red}",
        "focusBorder": "${blue}",
        "selection.background": "${brightYellow}",
        "icon.foreground": "${brightBlack}",
        "widget.border": "#dcdcdc",
        "widget.shadow": "${black}18",
        "textLink.foreground": "${blue}",
        "textLink.activeForeground": "${magenta}",
        "textBlockQuote.background": "#f6f6f6",
        "textBlockQuote.border": "${cyan}",
        "textCodeBlock.background": "#f6f6f6",
        "textPreformat.foreground": "${cyan}",
        "textSeparator.foreground": "#dcdcdc",
        "activityBar.background": "#f6f6f6",
        "activityBar.foreground": "${blue}",
        "activityBar.inactiveForeground": "${brightBlack}",
        "activityBar.border": "#e8e8e8",
        "activityBar.activeBorder": "${blue}",
        "activityBarBadge.background": "${blue}",
        "activityBarBadge.foreground": "${white}",
        "sideBar.background": "#fafafa",
        "sideBar.foreground": "${black}",
        "sideBar.border": "#e8e8e8",
        "sideBarTitle.foreground": "${black}",
        "sideBarSectionHeader.background": "#f2f2f2",
        "sideBarSectionHeader.foreground": "${brightBlack}",
        "sideBarSectionHeader.border": "#e8e8e8",
        "titleBar.activeBackground": "#f6f6f6",
        "titleBar.activeForeground": "${black}",
        "titleBar.inactiveBackground": "#fafafa",
        "titleBar.inactiveForeground": "${brightBlack}",
        "titleBar.border": "#e8e8e8",
        "commandCenter.background": "${white}",
        "commandCenter.foreground": "${brightBlack}",
        "commandCenter.border": "#dcdcdc",
        "editorGroupHeader.tabsBackground": "#f6f6f6",
        "editorGroupHeader.tabsBorder": "#e8e8e8",
        "editorGroup.border": "#e8e8e8",
        "tab.activeBackground": "${white}",
        "tab.activeForeground": "${black}",
        "tab.activeBorder": "${white}",
        "tab.activeBorderTop": "${blue}",
        "tab.inactiveBackground": "#f6f6f6",
        "tab.inactiveForeground": "${brightBlack}",
        "tab.border": "#e8e8e8",
        "tab.hoverBackground": "${white}",
        "tab.unfocusedActiveForeground": "${brightBlack}",
        "breadcrumb.foreground": "${brightBlack}",
        "breadcrumb.focusForeground": "${blue}",
        "breadcrumb.activeSelectionForeground": "${blue}",
        "editor.background": "${white}",
        "editor.foreground": "${black}",
        "editorCursor.foreground": "${black}",
        "editor.selectionBackground": "${brightYellow}",
        "editor.selectionForeground": "${black}",
        "editor.inactiveSelectionBackground": "${black}14",
        "editor.selectionHighlightBackground": "${blue}12",
        "editor.selectionHighlightBorder": "${blue}33",
        "editor.wordHighlightBackground": "${cyan}18",
        "editor.wordHighlightStrongBackground": "${cyan}28",
        "editor.findMatchBackground": "${brightYellow}",
        "editor.findMatchForeground": "${black}",
        "editor.findMatchBorder": "${black}",
        "editor.findMatchHighlightBackground": "${brightYellow}",
        "editor.findMatchHighlightForeground": "${black}",
        "editor.findRangeHighlightBackground": "${blue}0a",
        "searchEditor.findMatchBackground": "${brightYellow}",
        "editor.lineHighlightBackground": "${black}05",
        "editor.lineHighlightBorder": "${black}00",
        "editor.rangeHighlightBackground": "${blue}0a",
        "editor.hoverHighlightBackground": "${black}08",
        "editorLink.activeForeground": "${blue}",
        "editorLineNumber.foreground": "#767676",
        "editorLineNumber.activeForeground": "${black}",
        "editorWhitespace.foreground": "${black}26",
        "editorIndentGuide.background1": "#e8e8e8",
        "editorIndentGuide.activeBackground1": "#a0a0a0",
        "editorRuler.foreground": "#e8e8e8",
        "editorBracketMatch.background": "${blue}12",
        "editorBracketMatch.border": "${blue}",
        "editorBracketHighlight.foreground1": "${blue}",
        "editorBracketHighlight.foreground2": "${magenta}",
        "editorBracketHighlight.foreground3": "${cyan}",
        "editorBracketHighlight.foreground4": "${green}",
        "editorBracketHighlight.foreground5": "${magenta}",
        "editorBracketHighlight.foreground6": "${blue}",
        "editorBracketHighlight.unexpectedBracket.foreground": "${red}",
        "editorGutter.background": "${white}",
        "editorGutter.addedBackground": "${green}",
        "editorGutter.modifiedBackground": "${blue}",
        "editorGutter.deletedBackground": "${red}",
        "editorError.foreground": "${red}",
        "editorWarning.foreground": "${magenta}",
        "editorInfo.foreground": "${blue}",
        "editorHint.foreground": "${cyan}",
        "editorOverviewRuler.errorForeground": "${red}b3",
        "editorOverviewRuler.warningForeground": "${magenta}b3",
        "editorOverviewRuler.infoForeground": "${blue}b3",
        "editorOverviewRuler.border": "#e8e8e8",
        "editorInlayHint.background": "${black}08",
        "editorInlayHint.foreground": "${brightBlack}",
        "editorCodeLens.foreground": "${brightBlack}",
        "editorGhostText.foreground": "#767676",
        "editorStickyScroll.background": "${white}",
        "editorStickyScrollHover.background": "#f6f6f6",
        "editorWidget.background": "#fafafa",
        "editorWidget.foreground": "${black}",
        "editorWidget.border": "#dcdcdc",
        "editorHoverWidget.background": "#fafafa",
        "editorHoverWidget.foreground": "${black}",
        "editorHoverWidget.border": "#dcdcdc",
        "editorSuggestWidget.background": "#fafafa",
        "editorSuggestWidget.foreground": "${black}",
        "editorSuggestWidget.border": "#dcdcdc",
        "editorSuggestWidget.highlightForeground": "${blue}",
        "editorSuggestWidget.selectedBackground": "${brightYellow}",
        "editorSuggestWidget.selectedForeground": "${black}",
        "editorSuggestWidget.focusHighlightForeground": "${black}",
        "diffEditor.insertedTextBackground": "${green}26",
        "diffEditor.removedTextBackground": "${red}26",
        "diffEditor.insertedLineBackground": "${green}0d",
        "diffEditor.removedLineBackground": "${red}0d",
        "diffEditor.diagonalFill": "#dcdcdc",
        "list.activeSelectionBackground": "${brightYellow}",
        "list.activeSelectionForeground": "${black}",
        "list.inactiveSelectionBackground": "${black}0a",
        "list.inactiveSelectionForeground": "${black}",
        "list.focusBackground": "${brightYellow}",
        "list.focusForeground": "${black}",
        "list.focusOutline": "${blue}",
        "list.hoverBackground": "${black}08",
        "list.hoverForeground": "${black}",
        "list.highlightForeground": "${blue}",
        "list.errorForeground": "${red}",
        "list.warningForeground": "${magenta}",
        "tree.indentGuidesStroke": "#dcdcdc",
        "quickInput.background": "${white}",
        "quickInput.foreground": "${black}",
        "quickInputTitle.background": "#f6f6f6",
        "quickInputList.focusBackground": "${brightYellow}",
        "quickInputList.focusForeground": "${black}",
        "input.background": "${white}",
        "input.foreground": "${black}",
        "input.border": "#dcdcdc",
        "input.placeholderForeground": "#767676",
        "inputOption.activeBackground": "${blue}18",
        "inputOption.activeBorder": "${blue}",
        "inputOption.activeForeground": "${blue}",
        "inputValidation.errorBackground": "#fcf2f2",
        "inputValidation.errorBorder": "${red}",
        "inputValidation.warningBackground": "#faf2fa",
        "inputValidation.warningBorder": "${magenta}",
        "inputValidation.infoBackground": "#f2f2fc",
        "inputValidation.infoBorder": "${blue}",
        "dropdown.background": "${white}",
        "dropdown.foreground": "${black}",
        "dropdown.border": "#dcdcdc",
        "button.background": "${blue}",
        "button.foreground": "${white}",
        "button.hoverBackground": "#00008e",
        "button.secondaryBackground": "#eeeeee",
        "button.secondaryForeground": "${black}",
        "button.secondaryHoverBackground": "#e2e2e2",
        "badge.background": "${blue}",
        "badge.foreground": "${white}",
        "progressBar.background": "${blue}",
        "scrollbar.shadow": "${black}00",
        "scrollbarSlider.background": "${black}20",
        "scrollbarSlider.hoverBackground": "${black}33",
        "scrollbarSlider.activeBackground": "${black}4d",
        "panel.background": "${white}",
        "panel.border": "#e8e8e8",
        "panelTitle.activeForeground": "${black}",
        "panelTitle.activeBorder": "${blue}",
        "panelTitle.inactiveForeground": "${brightBlack}",
        "statusBar.background": "#f6f6f6",
        "statusBar.foreground": "${brightBlack}",
        "statusBar.border": "#e8e8e8",
        "statusBar.noFolderBackground": "#f6f6f6",
        "statusBar.noFolderForeground": "${brightBlack}",
        "statusBar.debuggingBackground": "${magenta}",
        "statusBar.debuggingForeground": "${white}",
        "statusBarItem.remoteBackground": "${cyan}",
        "statusBarItem.remoteForeground": "${white}",
        "statusBarItem.errorBackground": "${red}",
        "statusBarItem.errorForeground": "${white}",
        "statusBarItem.warningBackground": "${magenta}",
        "statusBarItem.warningForeground": "${white}",
        "statusBarItem.hoverBackground": "${black}0a",
        "terminal.background": "${white}",
        "terminal.foreground": "${black}",
        "terminalCursor.background": "${white}",
        "terminalCursor.foreground": "${black}",
        "terminal.selectionBackground": "${brightYellow}",
        "terminal.selectionForeground": "${black}",
        "terminal.inactiveSelectionBackground": "${black}14",
        "terminal.findMatchBackground": "${brightYellow}",
        "terminal.ansiBlack": "${black}",
        "terminal.ansiRed": "${red}",
        "terminal.ansiGreen": "${green}",
        "terminal.ansiYellow": "${yellow}",
        "terminal.ansiBlue": "${blue}",
        "terminal.ansiMagenta": "${magenta}",
        "terminal.ansiCyan": "${cyan}",
        "terminal.ansiWhite": "${white}",
        "terminal.ansiBrightBlack": "${brightBlack}",
        "terminal.ansiBrightRed": "${brightRed}",
        "terminal.ansiBrightGreen": "${brightGreen}",
        "terminal.ansiBrightYellow": "${brightYellow}",
        "terminal.ansiBrightBlue": "${brightBlue}",
        "terminal.ansiBrightMagenta": "${brightMagenta}",
        "terminal.ansiBrightCyan": "${brightCyan}",
        "terminal.ansiBrightWhite": "${brightWhite}",
        "gitDecoration.addedResourceForeground": "${green}",
        "gitDecoration.modifiedResourceForeground": "${blue}",
        "gitDecoration.deletedResourceForeground": "${red}",
        "gitDecoration.untrackedResourceForeground": "${green}",
        "gitDecoration.ignoredResourceForeground": "#767676",
        "gitDecoration.conflictingResourceForeground": "${magenta}",
        "gitDecoration.stageModifiedResourceForeground": "${green}",
        "gitDecoration.stageDeletedResourceForeground": "${red}",
        "notificationCenterHeader.background": "#f6f6f6",
        "notifications.background": "${white}",
        "notifications.foreground": "${black}",
        "notifications.border": "#dcdcdc",
        "notificationsErrorIcon.foreground": "${red}",
        "notificationsWarningIcon.foreground": "${magenta}",
        "notificationsInfoIcon.foreground": "${blue}",
        "menu.background": "${white}",
        "menu.foreground": "${black}",
        "menu.selectionBackground": "${brightYellow}",
        "menu.selectionForeground": "${black}",
        "menu.separatorBackground": "#e8e8e8",
        "peekView.border": "${blue}",
        "peekViewEditor.background": "${white}",
        "peekViewResult.background": "#fafafa",
        "peekViewTitle.background": "#f6f6f6",
        "peekViewTitleLabel.foreground": "${black}",
        "peekViewTitleDescription.foreground": "${brightBlack}",
        "debugToolBar.background": "#fafafa",
        "debugIcon.breakpointForeground": "${red}",
        "debugIcon.startForeground": "${green}",
        "debugIcon.pauseForeground": "${blue}",
        "testing.iconPassed": "${green}",
        "testing.iconFailed": "${red}",
        "testing.iconQueued": "${brightBlack}",
        "charts.blue": "${blue}",
        "charts.green": "${green}",
        "charts.red": "${red}",
        "charts.yellow": "${yellow}",
        "charts.purple": "${magenta}"
    },
    "tokenColors": [
        {
            "name": "Plain text, variables, and punctuation",
            "scope": ["variable", "meta.embedded", "punctuation", "keyword.operator"],
            "settings": {"foreground": "${black}"}
        },
        {
            "name": "Italic grey comments, matching nvim/init.vim",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {"foreground": "${brightBlack}", "fontStyle": "italic"}
        },
        {
            "name": "Keywords and control flow",
            "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"],
            "settings": {"foreground": "${blue}"}
        },
        {
            "name": "Strings and regular expressions",
            "scope": ["string", "constant.other.symbol"],
            "settings": {"foreground": "${green}"}
        },
        {
            "name": "Numbers, booleans, and constants",
            "scope": ["constant.numeric", "constant.language", "constant.character", "variable.other.constant", "support.constant"],
            "settings": {"foreground": "${magenta}"}
        },
        {
            "name": "Types, namespaces, and classes",
            "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"],
            "settings": {"foreground": "${magenta}"}
        },
        {
            "name": "Functions and methods",
            "scope": ["entity.name.function", "support.function", "variable.function"],
            "settings": {"foreground": "${cyan}"}
        },
        {
            "name": "Parameters and properties",
            "scope": ["variable.parameter", "variable.other.property", "variable.object.property", "support.variable.property"],
            "settings": {"foreground": "${black}"}
        },
        {
            "name": "Escapes and interpolation markers",
            "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"],
            "settings": {"foreground": "${magenta}"}
        },
        {
            "name": "Embedded expressions inside strings",
            "scope": ["meta.embedded.line", "meta.embedded.block", "meta.template.expression"],
            "settings": {"foreground": "${black}"}
        },
        {
            "name": "Tags and CSS selectors",
            "scope": ["entity.name.tag", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
            "settings": {"foreground": "${blue}"}
        },
        {
            "name": "Attributes, decorators, and annotations",
            "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "storage.type.annotation"],
            "settings": {"foreground": "${magenta}"}
        },
        {
            "name": "JSON and YAML keys",
            "scope": ["support.type.property-name.json", "support.type.property-name.jsonc", "entity.name.tag.yaml"],
            "settings": {"foreground": "${cyan}"}
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name.css", "support.type.property-name.scss", "support.type.property-name.less"],
            "settings": {"foreground": "${cyan}"}
        },
        {
            "name": "Preprocessor directives",
            "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive"],
            "settings": {"foreground": "${magenta}"}
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": {"foreground": "${blue}", "fontStyle": "bold"}
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link", "constant.other.reference.link"],
            "settings": {"foreground": "${blue}"}
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown", "markup.raw.block"],
            "settings": {"foreground": "${cyan}"}
        },
        {
            "name": "Markdown emphasis",
            "scope": ["markup.italic"],
            "settings": {"fontStyle": "italic"}
        },
        {
            "name": "Markdown strong emphasis",
            "scope": ["markup.bold"],
            "settings": {"fontStyle": "bold"}
        },
        {
            "name": "Markdown strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": {"fontStyle": "strikethrough"}
        },
        {
            "name": "Diff additions",
            "scope": ["markup.inserted"],
            "settings": {"foreground": "${green}"}
        },
        {
            "name": "Diff deletions and invalid syntax",
            "scope": ["markup.deleted", "invalid"],
            "settings": {"foreground": "${red}"}
        },
        {
            "name": "Diff changes",
            "scope": ["markup.changed"],
            "settings": {"foreground": "${blue}"}
        }
    ],
    "semanticTokenColors": {
        "comment": {"foreground": "${brightBlack}", "italic": true},
        "keyword": "${blue}",
        "modifier": "${blue}",
        "operator": "${black}",
        "string": "${green}",
        "regexp": "${green}",
        "number": "${magenta}",
        "type": "${magenta}",
        "class": "${magenta}",
        "interface": "${magenta}",
        "struct": "${magenta}",
        "enum": "${magenta}",
        "typeParameter": "${magenta}",
        "namespace": "${magenta}",
        "decorator": "${magenta}",
        "function": "${cyan}",
        "method": "${cyan}",
        "macro": "${magenta}",
        "variable": "${black}",
        "parameter": "${black}",
        "property": "${black}",
        "enumMember": "${magenta}",
        "variable.readonly": "${magenta}",
        "property.readonly": "${magenta}"
    }
}
