#!/bin/sh
set -eu

# Nested helpers set PBC_SKIP so only the outermost result reaches the clipboard.
if [ -n "${PBC_SKIP-}" ]; then
	exec cat
fi
zsh -o pipefail -c '
    IFS= read -r -k 1 -u 0 first || exit 0
    { printf "%s" "$first"; cat; } | tee /dev/fd/3 | perl -pe "chomp if eof" | pbcopy
' 3>&1
