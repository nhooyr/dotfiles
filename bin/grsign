#!/bin/sh
set -eu

case "$#:$*" in
0:) ;;
1:-h | 1:--help)
	printf 'Usage: grsign\nRe-sign commits and annotated tags on all local branches and tags.\n'
	exit 0
	;;
*)
	printf 'Usage: grsign\n' >&2
	exit 2
	;;
esac

grsign_dir=$(mktemp -d)
trap 'rm -rf -- "$grsign_dir"' 0
trap 'exit 1' HUP INT TERM

git for-each-ref --format='%(refname) %(objectname)' refs/tags >"$grsign_dir/refs"
FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch \
	--original "refs/original/grsign-$$" \
	--commit-filter 'git commit-tree -S "$@"' \
	--tag-name-filter cat -- --branches --tags

perl - "$grsign_dir" "refs/original/grsign-$$" <<'PERL'
use strict;
use warnings;
my ($directory, $backup) = @ARGV;

sub git {
    open my $output, '-|', 'git', @_ or die "git: $!\n";
    local $/;
    my $text = <$output> // '';
    close $output or die "git @_ failed\n";
    return $text;
}

sub git_line {
    my $text = git(@_);
    chomp $text;
    return $text;
}

open my $saved, '<', "$directory/refs" or die "$directory/refs: $!\n";
my @refs = map { [split] } <$saved>;
close $saved;
exit unless @refs;

my %rewritten;
for my $entry (@refs) {
    my ($ref, $object) = @$entry;
    $rewritten{git_line('rev-parse', "$object^{}")} = git_line('rev-parse', "$ref^{}");
}

# Sign tag objects without replacing real refs while rebuilding inner tags.
my $objects = git_line('rev-parse', '--path-format=absolute', '--git-path', 'objects');
my $format = git_line('rev-parse', '--show-object-format');
git('init', '--bare', '--quiet', "--object-format=$format", "$directory/tags");
my @signer = ("--git-dir=$directory/tags", '-c', 'advice.nestedTag=false');
for (split /\0/, git('config', '--null', '--list')) {
    my ($key, $value) = split /\n/, $_, 2;
    push @signer, '-c', defined $value ? "$key=$value" : $key if $key =~ /^(?:user|gpg)\./;
}

sub rewrite_tag {
    my ($object) = @_;
    return $rewritten{$object} if exists $rewritten{$object};
    my ($header, $message) = split /\n\n/, git('cat-file', 'tag', $object), 2;
    my ($target) = $header =~ /^object (.+)$/m;
    my ($tag) = $header =~ /^tag (.+)$/m;
    my ($name, $email, $date) = $header =~ /^tagger (.*) <(.*)> (\d+ [+-]\d{4})$/m;
    defined $date or die "Missing tagger in $object\n";
    $target = rewrite_tag($target);
    $message =~ s/^-----BEGIN (?:PGP|SSH) SIGNATURE-----.*\z//ms;
    open my $file, '>', "$directory/message" or die "$directory/message: $!\n";
    print {$file} $message;
    close $file or die "$directory/message: $!\n";
    local $ENV{GIT_OBJECT_DIRECTORY} = $objects;
    local $ENV{GIT_COMMITTER_NAME} = $name;
    local $ENV{GIT_COMMITTER_EMAIL} = $email;
    local $ENV{GIT_COMMITTER_DATE} = '@' . $date;
    git(@signer, 'tag', '--force', '--sign', '--cleanup=verbatim', '--file', "$directory/message", '--', $tag, $target);
    return $rewritten{$object} = git_line(@signer, 'rev-parse', "refs/tags/$tag");
}

for my $entry (@refs) {
    my ($ref, $object) = @$entry;
    my $replacement = rewrite_tag($object);
    git('update-ref', "$backup/$ref", $object);
    git('update-ref', $ref, $replacement);
}
PERL
