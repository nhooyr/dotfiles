#!/bin/sh
set -eu

case "$#:$*" in
0:) ;;
1:-h | 1:--help)
	printf 'Usage: grsign\nRe-sign commits and annotated tags on all local branches and tags.\n'
	exit 0
	;;
*)
	printf 'Usage: grsign\n' >&2
	exit 2
	;;
esac

grsign_dir=$(mktemp -d)
trap 'rm -rf -- "$grsign_dir"' 0
trap 'exit 1' HUP INT TERM

git for-each-ref --shell \
	--format='ref=%(refname) type=%(objecttype) object=%(objectname) name=%(taggername) email=%(taggeremail:trim) date=%(taggerdate:raw)' \
	refs/tags >"$grsign_dir/refs"
FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch \
	--original "refs/original/grsign-$$" \
	--commit-filter 'git commit-tree -S "$@"' \
	--tag-name-filter cat -- --branches --tags

while IFS= read -r tag; do
	eval "$tag"
	[ "$type" = tag ] || continue
	git update-ref "refs/original/grsign-$$/$ref" "$object"
	git cat-file tag "$object" >"$grsign_dir/message"
	perl -0777 -i -pe 's/\A.*?\n\n//s; s/^-----BEGIN (?:PGP|SSH) SIGNATURE-----.*\z//ms' "$grsign_dir/message"
	GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email" GIT_COMMITTER_DATE="@$date" \
		git tag --force --sign --cleanup=verbatim --file "$grsign_dir/message" \
		-- "${ref#refs/tags/}" "$ref^{}"
done <"$grsign_dir/refs"
