#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
	printf 'Usage: %s <src> <dst>\n' "${0##*/}" >&2
	exit 1
fi

src="$1"
dst="$2"

if [ ! -e "$src" ]; then
	printf '%s: %s does not exist\n' "${0##*/}" "$src" >&2
	exit 1
fi
src=$(realpath -- "$src")

if [ -L "$dst" ]; then
	printf '%s: %s: overwriting symlink %s\n' "${0##*/}" "$(basename "$PWD")" "$dst" | hpath
	rm -- "$dst"
elif [ -e "$dst" ]; then
	printf '%s: %s exists and is not a symlink\n' "${0##*/}" "$dst" >&2
	exit 1
else
	printf '%s: %s: linking %s\n' "${0##*/}" "$(basename "$PWD")" "$dst" | hpath
fi

mkdir -p -- "$(dirname -- "$dst")"
ln -s -- "$src" "$dst"
