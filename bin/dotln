#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
	echo "Usage: $0 src dst" >&2
	exit 1
fi

src="$1"
dst="$2"

if [ ! -e "$src" ]; then
	echo "$src does not exist" >&2
	exit 1
fi
src=$(realpath -- "$src")

if [ -L "$dst" ]; then
	echo "overwriting symlink $dst"
	rm -- "$dst"
elif [ -e "$dst" ]; then
	echo "$dst exists and is not a symlink"
	exit 1
else
	echo "linking $dst"
fi

mkdir -p -- "$(dirname -- "$dst")"
ln -s -- "$src" "$dst"
