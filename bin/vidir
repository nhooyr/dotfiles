#!/usr/bin/env perl
use strict;
use warnings;
use Cwd                   qw(abs_path);
use File::Basename        qw(basename);
use File::Path            qw(make_path);
use File::Spec::Functions qw(tmpdir);
use File::Temp            qw(tempfile);
use Fcntl                 qw(F_SETFL O_NONBLOCK);
use Getopt::Long          qw(GetOptions);
use IO::Select;
use IPC::Open2;

my $name = basename($0);
my ( $recursive, $no_ignore, $help );
Getopt::Long::Configure(qw(no_auto_abbrev no_ignore_case bundling require_order));
GetOptions( 'r|recursive' => \$recursive, 'no-ignore' => \$no_ignore, 'h|help' => \$help ) or exit 2;
if ($help) {
    print <<"HELP";
usage: $name [-r] [--no-ignore] [DIR]

Edit a shell script of mv commands for DIR (default: the current directory).
The script includes hidden entries and uses relative filenames.
Entries follow GNU ls ordering: directories first, with ascending version numbers.
Real directories have a trailing /; directory symlinks are left unchanged.
Inside a Git worktree, ignore Git-ignored entries and .git.
When stdin is not a terminal, use its newline-separated paths in input order.
Relative paths use the current directory; supplied directories are not scanned.
Do not pass DIR with piped input. Scan options below apply only to DIR listings.

  -r, --recursive  Include descendants after their parent directories.
                   Directory symlinks are listed without following them.
  --no-ignore      Include Git-ignored entries and .git.
  -h, --help       Show this help.

Move commands start commented out. Edit and uncomment the commands you want.
Open the script with editor and wait. On successful editor exit, print its
quoted executable path. The script is kept for you to run, edit, or reuse;
no file operations run automatically. Exit the editor with an error to cancel.
HELP
    exit 0;
}
die "usage: $name [-r] [--no-ignore] [DIR]\n" if @ARGV > 1;
my $from_stdin = !-t STDIN;
die "$name: cannot combine DIR with piped paths\n" if $from_stdin && @ARGV;
my $directory = abs_path( $ARGV[0] // '.' );
die "$name: not a directory: " . ( $ARGV[0] // '.' ) . "\n" unless defined($directory) && -d $directory;
my $git_check  = 'git -C ' . quote($directory) . ' rev-parse --is-inside-work-tree 2>/dev/null';
my $use_ignore = !$from_stdin && !$no_ignore && `$git_check` eq "true\n";

sub quote {
    my ($value) = @_;
    return $value if $value =~ m{\A[A-Za-z0-9_./-]+\z};
    $value =~ s/'/'\\''/g;
    return "'$value'";
}

sub path_quote {
    my ($path) = @_;
    my ( $label, $prefix ) = ( '', '' );
    for my $variable ( split /:/, $ENV{AQSNOW_DIRALIS} // '' ) {
        next unless length( $ENV{$variable} // '' );
        my $value = abs_path( $ENV{$variable} );
        next unless defined($value) && -d $value && length($value) > length($prefix);
        next unless $path eq $value || index( $path, $value eq '/' ? '/' : "$value/" ) == 0;
        ( $label, $prefix ) = ( $variable eq 'HOME' ? '~' : "\$$variable", $value );
    }
    return quote($path) if $label eq '';
    my $suffix = substr( $path, length($prefix) );
    $suffix = "/$suffix" if $prefix eq '/' && length($suffix);
    return $label . $suffix if $label eq '~' && $path =~ m{\A[A-Za-z0-9_./-]+\z};
    return $suffix eq '' ? '~' : '~/' . quote( substr( $suffix, 1 ) ) if $label eq '~';
    $suffix =~ s/([\\"\$`])/\\$1/g;
    return '"' . $label . $suffix . '"';
}

sub copy_command {
    my ( $program, $text ) = @_;
    open my $pipe, '|-', $program or die "$name: $program: $!\n";
    print {$pipe} $text or die "$name: write to $program: $!\n";
    close $pipe         or die "$name: $program failed\n";
}

my ( $ignore_input, $ignore_output, $ignore_pid );

sub ignored_paths {
    return () unless @_;
    if ( !defined $ignore_pid ) {
        local $ENV{GIT_FLUSH} = 1;
        my @command =
          ( 'git', '-C', $directory, 'check-ignore', qw(--no-index --stdin -z --verbose --non-matching) );
        $ignore_pid = open2( $ignore_output, $ignore_input, @command );
        fcntl( $ignore_input, F_SETFL, O_NONBLOCK ) or die "$name: nonblocking git input: $!\n";
    }
    my $input = join( "\0", @_ ) . "\0";
    my ( $sent, $received, $buffer ) = ( 0, 0, '' );
    my %ignored;
    my $read  = IO::Select->new($ignore_output);
    my $write = IO::Select->new($ignore_input);
    local $SIG{PIPE} = 'IGNORE';
    while ( $received < @_ ) {

        # Drain replies while sending the batch so neither pipe can fill and block the other.
        my ( $readable, $writable ) = IO::Select->select( $read, $write );
        die "$name: wait for git: $!\n" unless defined $readable;
        if (@$readable) {
            my $count = sysread( $ignore_output, my $chunk, 65536 );
            die "$name: incomplete git check-ignore response\n" unless $count;
            $buffer .= $chunk;

            # Each reply contains a source, line, pattern and path separated by NULs.
            while ( $buffer =~ /\G[^\0]*\0[^\0]*\0([^\0]*)\0([^\0]*)\0/gc ) {
                $ignored{$2} = 1 if length($1) && substr( $1, 0, 1 ) ne '!';
                ++$received;
            }
            substr( $buffer, 0, pos($buffer) // 0, '' );
        }
        if (@$writable) {
            my $count = syswrite( $ignore_input, $input, length($input) - $sent, $sent );
            die "$name: write to git: $!\n" unless $count;
            $sent += $count;
            $write->remove($ignore_input) if $sent == length($input);
        }
    }
    return %ignored;
}

sub write_paths {
    my ( $path, $prefix, $file ) = @_;
    local $ENV{LC_COLLATE} = 'C';
    open my $listing, '-|', 'gls', '-1Av', '--group-directories-first', '--zero', '--', $path
      or die "$name: gls: $!\n";
    my @names;
    {
        local $/ = "\0";
        @names = map { chomp; $_ } <$listing>;
    }
    close $listing or die "$name: cannot list $path\n";
    my $parent = $path eq '/' ? '/' : "$path/";
    @names = grep { $_ ne '.git' } @names if $use_ignore;
    my %ignored = $use_ignore ? ignored_paths( map { "$parent$_" } @names ) : ();
    for my $entry (@names) {
        my $full = "$parent$entry";
        next if $ignored{$full};
        my $relative     = $prefix . $entry;
        my $is_directory = !-l $full && -d _;
        my $quoted       = quote( $relative . ( $is_directory ? '/' : '' ) );
        print {$file} "# mv -v -- $quoted $quoted\n";
        write_paths( $full, "$relative/", $file ) if $recursive && $is_directory;
    }
}

my $prefix    = $directory eq '/' ? 'root' : basename($directory);
my $temporary = tmpdir() . '/vidir';
make_path( $temporary, { mode => 0700 } );
my ( $file, $script ) = tempfile( "$prefix.XXXXXX", SUFFIX => '.sh', DIR => $temporary, UNLINK => 0 );
print {$file} "#!/bin/sh\nset -eu\ncd -- ", path_quote($directory), "\n";
if ($from_stdin) {
    while ( my $path = <STDIN> ) {
        chomp $path;
        $path .= '/' if !-l $path && -d _ && $path !~ m{/$};
        my $quoted = quote($path);
        print {$file} "# mv -v -- $quoted $quoted\n";
    }
}
else {
    write_paths( $directory, '', $file );
}
if ( defined $ignore_pid ) {
    close $ignore_input                      or die "$name: close git input: $!\n";
    waitpid( $ignore_pid, 0 ) == $ignore_pid or die "$name: wait for git: $!\n";
    die "$name: git check-ignore failed\n" unless $? == 0 || $? == 256;
    close $ignore_output or die "$name: close git output: $!\n";
}
close $file or die "$name: $script: $!\n";
chmod 0700, $script or die "$name: $script: $!\n";
my $command = path_quote( abs_path($script) );
copy_command( 'pbcopy', $command );
my $status = system 'editor', $script;
die "$name: could not run editor: $!\n" if $status == -1;

if ($status) {
    warn "$name: editor failed; script kept at $script\n";
    exit( ( $status & 127 ) ? 128 + ( $status & 127 ) : $status >> 8 );
}

copy_command( 'pbc', "$command\n" );
