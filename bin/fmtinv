#!/bin/sh

format_invoice() {
	LC_ALL=C FMTINV_NAME="${0##*/}" awk '
        function trim(text) {
            sub(/^[[:space:]]+/, "", text)
            sub(/[[:space:]]+$/, "", text)
            return text
        }

        function fail(message) {
            error = message
            exit 1
        }

        function read_quoted_note(note, line, continuation) {
            while (note ~ /^"([^"]|"")*$/) {
                if ((getline continuation) <= 0)
                    fail("unterminated quoted note on line " line)
                sub(/\r$/, "", continuation)
                note = note "\n" continuation
            }
            if (!match(note, /^"([^"]|"")*"/) || substr(note, RLENGTH + 1) !~ /^[[:blank:]]*$/)
                fail("unexpected text after quoted note on line " NR)
            note = substr(note, 2, RLENGTH - 2)
            gsub(/""/, "\"", note)
            return note
        }

        function print_row(label, value, note) {
            printf "%-12s%*s", label, width, value
            if (note != "") {
                gsub(/\n/, "\n" sprintf("%*s", width + 14, ""), note)
                printf "  %s", note
            }
            printf "\n"
        }

        function format_note(note, lines, count, i) {
            count = split(note, lines, "\n")
            note = format_note_line(lines[1])
            for (i = 2; i <= count; i++)
                note = note "\n" format_note_line(lines[i])
            return note
        }

        function format_note_line(note, ranges, count, i, times, result) {
            # Invoice-specific wording. Other notes keep their original text.
            if (note == "ammar meeting") return "Meeting with Ammar"
            if (note == "weekly meeting") return "Weekly meeting"
            if (note == "wip rust bot poc") return "Rust bot proof of concept (WIP)"

            count = split(note, ranges, /[[:blank:]]*,[[:blank:]]*/)
            for (i = 1; i <= count; i++) {
                if (ranges[i] !~ ("^" clock separator clock "$"))
                    return note

                split(ranges[i], times, separator)
                if (times[1] !~ /:/) times[1] = times[1] ":00"
                if (times[2] !~ /:/) times[2] = times[2] ":00"
                result = result (i == 1 ? "" : ", ") times[1] "–" times[2]
            }
            return result
        }

        BEGIN {
            FS = "\t"
            clock = "([01]?[0-9]|2[0-3])(:[0-5][0-9])?"
            separator = "[[:blank:]]*(->|-|–)[[:blank:]]*"
            width = 7
        }

        /^[[:space:]]*$/ { next }

        {
            line = NR
            label = trim($1)
            value = trim($2)
            note = trim($3)

            if (row >= 2 && note ~ /^"([^"]|"")*$/) {
                # Read from the original record so tabs inside the note are retained.
                note = substr($0, length($1) + length($2) + 3)
                sub(/^ +/, "", note)
                sub(/\r$/, "", note)
                note = read_quoted_note(note, line)
            } else {
                for (i = 4; i <= NF; i++) {
                    if (trim($i) != "") fail("unexpected extra column on line " line)
                }
            }

            if (++row == 1) {
                title = label
                next
            }
            if (row == 2) {
                if (tolower(label) != "date" || tolower(value) != "hours" ||
                    tolower(note) != "notes")
                    fail("expected date, hours, and notes columns")
                next
            }

            key = tolower(label)
            if (key == "total due" && value ~ /^\$[0-9][0-9,]*(\.[0-9])?$/)
                value = value (value ~ /\./ ? "0" : ".00")

            if (value == "") fail("missing value on line " line)
            if (value ~ /^#(DIV\/0!|ERROR!|N\/A|NAME\?|NULL!|NUM!|REF!|VALUE!)$/)
                fail("spreadsheet error " value " on line " line)
            if (length(value) > width) width = length(value)

            if (key == "total hours" || key == "total due") {
                if (key in totals) fail("duplicate " key " on line " line)
                totals[key] = value
                total_notes[key] = note
            } else if (label ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) {
                dates[++count] = label
                hours[count] = value
                notes[count] = format_note(note)
            } else {
                fail("unexpected row " line)
            }
        }

        END {
            if (error == "" && (row < 2 || title == ""))
                error = "expected an invoice title and header"
            if (error != "") {
                print ENVIRON["FMTINV_NAME"] ": " error > "/dev/stderr"
                exit 1
            }

            for (i = 0; i < width; i++) rule = rule "-"
            print title
            printf "%-10s  %*s  %s\n", "date", width, "hours", "notes"
            printf "----------  %s  --------------------------------\n", rule
            for (i = 1; i <= count; i++)
                print_row(dates[i], hours[i], notes[i])
            if ("total hours" in totals || "total due" in totals)
                printf "----------  %s\n", rule
            if ("total hours" in totals)
                print_row("total hours:", totals["total hours"], total_notes["total hours"])
            if ("total due" in totals)
                print_row("total due:", totals["total due"], total_notes["total due"])
        }
    '
}

is_formatted_invoice() {
	# Match the heading and separator, including the variable hours width.
	printf '%s\n' "$1" | LC_ALL=C awk '
        NR <= 3 { sub(/\r$/, ""); gsub(/ /, " ") }
        NR == 1 { has_title = $0 ~ /[^[:space:]]/ }
        NR == 2 { header = $0 }
        NR == 3 {
            columns = split($0, rule, /  /)
            width = length(rule[2])
            formatted = has_title && columns == 3 && rule[1] == "----------" &&
                width >= 7 && rule[2] ~ /^-+$/ &&
                rule[3] == "--------------------------------" &&
                header == sprintf("%-10s  %*s  %s", "date", width, "hours", "notes")
            exit
        }
        END { exit !formatted }
    '
}

render_rtf() {
	osascript -l JavaScript -e '
ObjC.import("Cocoa");

function escapeRTF(text) {
    return text.replace(/[\\{}\t\u0080-\uFFFF]/g, function (character) {
        if (character === "\t") return "\\tab ";
        var unit = character.charCodeAt(0);
        if (unit < 128) return "\\" + character;
        return "\\u" + (unit > 32767 ? unit - 65536 : unit) + "?";
    });
}

function bold(text) {
    return "{\\b " + escapeRTF(text) + "}";
}

function formatLine(line, index) {
    if (index === 0) {
        var period = / \(([^()]+)\)$/.exec(line);
        if (period) {
            return bold(line.slice(0, period.index)) +
                " ({\\i " + escapeRTF(period[1]) + "})";
        }
    }
    if (index < 2) return bold(line);

    var total = /^total (?:hours|due):/.exec(line);
    if (total) return bold(total[0]) + escapeRTF(line.slice(total[0].length));
    return escapeRTF(line);
}

function run() {
    var data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
    var input = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding);
    if (input.isNil()) throw Error("Invoice text must be UTF-8.");

    var lines = ObjC.unwrap(input).split(/\r?\n/);
    var font = $.NSFont.fontWithNameSize("SFMono-Regular", 13).isNil() ? "Menlo" : "SF Mono";
    return "{\\rtf1\\ansi\\deff0\\uc1\n" +
        "{\\fonttbl{\\f0\\fmodern\\fprq1\\fcharset0 " + font + ";}}\n" +
        "\\pard\\f0\\fs26 " + lines.map(formatLine).join("\\par \n") + "\n}";
}
'
}

case $# in
0)
	if ! command -v pbpaste >/dev/null 2>&1; then
		printf '%s: pbpaste is unavailable; pass a TSV file or - for stdin.\n' "${0##*/}" >&2
		exit 1
	fi
	invoice=$(pbpaste) || exit 1
	;;
1)
	invoice=$(cat -- "$1") || exit 1
	;;
*)
	printf 'Usage: %s [file.tsv|-]\n' "${0##*/}" >&2
	exit 2
	;;
esac

# Strip an optional UTF-8 BOM before detecting the input format.
invoice=${invoice#"$(printf '\357\273\277')"}
rtf=
case $invoice in
'{\rtf'*)
	rtf=$invoice
	plain=$(printf '%s' "$rtf" |
		textutil -stdin -format rtf -convert txt -encoding UTF-8 -stdout) || exit 1
	if ! is_formatted_invoice "$plain"; then
		printf '%s: rich text does not contain a formatted invoice.\n' "${0##*/}" >&2
		exit 1
	fi
	;;
*)
	if is_formatted_invoice "$invoice"; then
		plain=$invoice
	else
		plain=$(printf '%s\n' "$invoice" | format_invoice) || exit 1
	fi
	;;
esac

if [ -z "$rtf" ]; then
	rtf=$(printf '%s' "$plain" | render_rtf) || exit 1
	case $rtf in
	'{\rtf'*) ;;
	*)
		printf '%s: osascript did not return RTF.\n' "${0##*/}" >&2
		exit 1
		;;
	esac
elif [ "$#" -eq 0 ]; then
	rtf=
fi

printf '%s\n' "$plain" || exit 1
if [ -n "$rtf" ]; then
	printf '%s' "$rtf" | pbcopy
fi
