#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
	set 20
elif [ "$#" -gt 1 ]; then
	echo "${0##*/}: only 0 or 1 argument accepted" >&2
	exit 1
fi

case "$1" in
'' | *[!0-9]*)
	echo "${0##*/}: length must be a positive integer" >&2
	exit 1
	;;
esac

if [ "${#1}" -gt 4 ] || [ "$1" -lt 5 ]; then
	echo "${0##*/}: 5 <= length <= 9999" >&2
	exit 1
fi

length="$(printf %s "$1" | sed 's/^0*//')"
rand_length="$((length - 4))"
pass="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c$rand_length)"
if [ "${#pass}" -ne "$rand_length" ]; then
	echo "${0##*/}: unable to generate enough random characters" >&2
	exit 1
fi
printf "%s0xX#\n" "$pass" | pbc
