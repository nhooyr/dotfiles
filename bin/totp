#!/bin/sh
set -eu

secret="$*"
if [ -z "$secret" ]; then
	secret="$(pbpaste)"
fi

if test -z "$secret"; then
	echo "$(basename "$0"): no secret in \$1 or clipboard" >&2
	exit 1
fi

case "$secret" in
otpauth://totp/*\?*)
	# Read the secret query parameter; the account label and issuer are unused.
	query="${secret#*\?}"
	query="${query%%#*}"
	# Reject settings that would otherwise generate the wrong code.
	unsupported="$(printf %s "$query" | tr '&' '\n' | sed -nE '
       /^(algorithm=SHA1|digits=6|period=30)$/d
       /^(algorithm|digits|period)=/p
   ')"
	if [ -n "$unsupported" ]; then
		echo "$(basename "$0"): only SHA1, 6 digits, and a 30-second period are supported" >&2
		exit 1
	fi
	# Split before decoding so escaped delimiters stay inside their fields.
	secret="$(printf %s "$query" | jq -Rrs '
        split("&")
        | map(split("=") | {
            key: (.[0] // ""),
            value: (.[1:] | join("="))
        } | map_values(@urid))
        | map(select(.key == "secret")) | last.value // empty
        | select(contains("\u0000") | not)
    ')"
	if test -z "$secret"; then
		echo "$(basename "$0"): unable to parse otpauth secret URL" >&2
		exit 1
	fi
	;;
totp:* | TOTP:*)
	secret="$(printf %s "$secret" | sed 's/^totp:[[:space:]]*//i')"
	;;
esac

code="$(printf %s "$secret" | oathtool --totp -b -)"
printf '%s\n' "$code" | pbc
