#!/bin/sh
# Copy the current TOTP code for a base32 secret or an otpauth://totp/ URL,
# given as arguments or read from the clipboard.
set -eu

input="$*"
if [ -z "$input" ]; then
	input="$(pbpaste)"
fi
# Secrets are case-insensitive and often shown in spaced groups.
input="$(printf %s "$input" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"

# URL parameters can be percent-encoded (RFC 3986), like %3d for = padding.
urldecode() {
	printf %s "$1" | awk '
		function hex(h) {
			return index("0123456789abcdef", substr(h, 1, 1)) * 16 - 16 + index("0123456789abcdef", substr(h, 2, 1)) - 1
		}
		{
			while (match($0, /%[0-9a-f][0-9a-f]/)) {
				printf "%s%c", substr($0, 1, RSTART - 1), hex(substr($0, RSTART + 1, 2))
				$0 = substr($0, RSTART + 3)
			}
			print
		}' | tr '[:upper:]' '[:lower:]'
}

mode=--totp
set --
case "$input" in
otpauth://totp/*)
	secret=
	query="${input#*[?]}"
	query="${query%%#*}"
	set -f
	IFS='&'
	for param in $query; do
		param="$(urldecode "$param")"
		value="${param#*=}"
		case "$param" in
		secret=*) secret="$value" ;;
		algorithm=sha1) mode=--totp=SHA1 ;;
		algorithm=sha256) mode=--totp=SHA256 ;;
		algorithm=sha512) mode=--totp=SHA512 ;;
		algorithm=*)
			echo "totp: unsupported algorithm: $value" >&2
			exit 1
			;;
		digits=*) set -- "$@" "--digits=$value" ;;
		period=*) set -- "$@" "--time-step-size=${value}s" ;;
		esac
	done
	unset IFS
	set +f
	;;
otpauth://*)
	echo 'totp: only otpauth://totp/ URLs are supported' >&2
	exit 1
	;;
*)
	secret="${input#totp:}"
	;;
esac

# Drop base32 padding; oathtool doesn't need it.
secret="${secret%%=*}"
if [ -z "$secret" ]; then
	echo 'totp: no secret found' >&2
	exit 1
fi

# Generate first so a failure exits before touching the clipboard.
code="$(printf %s "$secret" | oathtool "$mode" -b "$@" -)"
printf '%s\n' "$code" | pbc
