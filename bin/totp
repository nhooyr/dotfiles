#!/bin/sh
set -eu

secret="${*:-$(pbpaste)}"
if [ -z "$secret" ]; then
	echo "$(basename "$0"): no secret in \$1 or clipboard" >&2
	exit 1
fi

case "$secret" in
otpauth://totp/*\?*)
	# Read the secret query parameter; the account label and issuer are unused.
	query="${secret#*\?}"
	query="${query%%#*}"
	# Split before decoding so escaped delimiters stay inside their fields.
	secret="$(printf %s "$query" | jq -Rrs '
        split("&")
        | map(split("=") | {
            key: (.[0] // ""),
            value: (.[1:] | join("="))
        } | map_values(@urid))
        | if any(.[];
            (.key == "algorithm" and .value != "SHA1") or
            (.key == "digits" and .value != "6") or
            (.key == "period" and .value != "30"))
          then error("only SHA1, 6 digits, and a 30-second period are supported")
          else map(select(.key == "secret")) | last.value // empty
          end
        | select(test("[\u0000-\u001f\u007f]") | not)
    ')"
	if [ -z "$secret" ]; then
		echo "$(basename "$0"): unable to parse otpauth secret URL" >&2
		exit 1
	fi
	;;
totp:* | TOTP:*)
	secret="$(printf %s "$secret" | sed 's/^totp:[[:space:]]*//i')"
	;;
esac

code="$(printf %s "$secret" | oathtool --totp -b -)"
printf '%s\n' "$code" | pbc
