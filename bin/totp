#!/bin/sh
set -eu

secret="$*"
if [ -z "$secret" ]; then
	secret="$(pbpaste)"
fi

if test -z "$secret"; then
	echo "$0: no secret in \$1 or clipboard" >&2
	exit 1
fi

case "$secret" in
otpauth://totp/*\?*)
	# Read the secret query parameter; the account label and issuer are unused.
	query="${secret#*\?}"
	query="${query%%#*}"
	secret="$(printf %s "&$query" | sed -nE 's/.*&secret=([^&]*).*/\1/p')"
	if test -z "$secret"; then
		echo "$0: unable to parse otpauth secret URL" >&2
		exit 1
	fi
	;;
totp:* | TOTP:*)
	secret="$(printf %s "$secret" | sed 's/^totp:\s*//i')"
	;;
esac

code="$(printf %s "$secret" | oathtool --totp -b -)"
printf '%s\n' "$code" | pbc
