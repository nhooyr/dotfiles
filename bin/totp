#!/bin/sh
set -eu

secret="$*"
if [ -z "$secret" ]; then
	secret="$(pbpaste)"
fi

if test -z "$secret"; then
	echo "$(basename "$0"): no secret in \$1 or clipboard" >&2
	exit 1
fi

case "$secret" in
otpauth://totp/*\?*)
	# Read the secret query parameter; the account label and issuer are unused.
	query="${secret#*\?}"
	query="${query%%#*}"
	# Split before decoding so escaped delimiters stay inside their fields.
	secret="$(printf %s "$query" | jq -Rrs --arg name "$(basename "$0")" '
        # Base32 secrets and supported option values are ASCII.
        def uridecode:
            @json | gsub("%(?<hex>[0-9a-fA-F]{2})"; "\\u00" + .hex) | fromjson;
        split("&")
        | map(split("=") | {
            key: (.[0] | uridecode),
            value: (.[1:] | join("=") | uridecode)
        })
        | if any(.[];
            (.key == "algorithm" and .value != "SHA1") or
            (.key == "digits" and .value != "6") or
            (.key == "period" and .value != "30")) then
            "\($name): only SHA1, 6 digits, and a 30-second period are supported\n"
            | halt_error(1)
        else
            map(select(.key == "secret")) | last.value // empty
            | select(contains("\u0000") | not)
        end
    ')"
	if test -z "$secret"; then
		echo "$(basename "$0"): unable to parse otpauth secret URL" >&2
		exit 1
	fi
	;;
totp:* | TOTP:*)
	secret="$(printf %s "$secret" | sed 's/^totp:[[:space:]]*//i')"
	;;
esac

code="$(printf %s "$secret" | oathtool --totp -b -)"
printf '%s\n' "$code" | pbc
