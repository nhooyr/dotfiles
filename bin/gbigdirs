#!/usr/bin/env perl
use strict;
use warnings;
use Fcntl qw(S_ISDIR);

if (@ARGV) {
    print STDERR "Usage: gbigdirs\n";
    exit 2;
}

open my $git, '-|', 'git', 'ls-files', '--recurse-submodules', '--deduplicate', '-z'
    or die "gbigdirs: git: $!\n";
my %sizes = ('.' => 0);
my %inodes;
my $failed = 0;
{
    local $/ = "\0";
    while (my $path = <$git>) {
        chomp $path;
        my @stat = lstat "./$path";
        if (!@stat) {
            next if $!{ENOENT} || $!{ENOTDIR};
            warn "gbigdirs: $path: $!\n";
            $failed = 1;
            next;
        }
        next if S_ISDIR($stat[2]);
        my ($directory) = $path =~ m{\A([^/]+)/};
        $sizes{"./$directory"} //= 0 if defined $directory;
        next if $stat[3] > 1 && $inodes{"$stat[0]:$stat[1]"}++;
        # Like du, measure allocated blocks and count hardlinked data only once.
        my $bytes = $stat[12] * 512;
        $sizes{'.'} += $bytes;
        $sizes{"./$directory"} += $bytes if defined $directory;
    }
}
close $git or exit(($? & 127) ? 128 + ($? & 127) : ($? >> 8) || 1);

sub human_size {
    my ($size) = @_;
    my @units = qw(B K M G T P E);
    my $unit = 0;
    while ($size >= 1024 && $unit < $#units) {
        $size /= 1024;
        ++$unit;
    }
    return sprintf($size < 10 && $unit ? '%.1f%s' : '%.0f%s', $size, $units[$unit]);
}

my @directories = sort { $sizes{$b} <=> $sizes{$a} || $a cmp $b } keys %sizes;
splice @directories, 16 if @directories > 16;
printf "%s\t%s\n", human_size($sizes{$_}), $_ for @directories;
exit $failed;
