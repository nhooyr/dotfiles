    "tokenColors": [
        {
            "name": "Plain text, variables, and punctuation",
            "scope": ["variable", "meta.embedded", "punctuation", "keyword.operator"],
            "settings": {"foreground": "#000000"}
        },
        {
            "name": "Italic grey comments, matching nvim/init.vim",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {"foreground": "#5c5c5c", "fontStyle": "italic"}
        },
        {
            "name": "Keywords and control flow",
            "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"],
            "settings": {"foreground": "#0000b2"}
        },
        {
            "name": "Strings and regular expressions",
            "scope": ["string", "constant.other.symbol"],
            "settings": {"foreground": "#0a5c07"}
        },
        {
            "name": "Numbers, booleans, and constants",
            "scope": ["constant.numeric", "constant.language", "constant.character", "variable.other.constant", "support.constant"],
            "settings": {"foreground": "#6e066e"}
        },
        {
            "name": "Types, namespaces, and classes",
            "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"],
            "settings": {"foreground": "#6e066e"}
        },
        {
            "name": "Functions and methods",
            "scope": ["entity.name.function", "support.function", "variable.function"],
            "settings": {"foreground": "#0a4045"}
        },
        {
            "name": "Parameters and properties",
            "scope": ["variable.parameter", "variable.other.property", "variable.object.property", "support.variable.property"],
            "settings": {"foreground": "#000000"}
        },
        {
            "name": "Escapes and interpolation markers",
            "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"],
            "settings": {"foreground": "#6e066e"}
        },
        {
            "name": "Embedded expressions inside strings",
            "scope": ["meta.embedded.line", "meta.embedded.block", "meta.template.expression"],
            "settings": {"foreground": "#000000"}
        },
        {
            "name": "Tags and CSS selectors",
            "scope": ["entity.name.tag", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
            "settings": {"foreground": "#0000b2"}
        },
        {
            "name": "Attributes, decorators, and annotations",
            "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "storage.type.annotation"],
            "settings": {"foreground": "#6e066e"}
        },
        {
            "name": "JSON and YAML keys",
            "scope": ["support.type.property-name.json", "support.type.property-name.jsonc", "entity.name.tag.yaml"],
            "settings": {"foreground": "#0a4045"}
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name.css", "support.type.property-name.scss", "support.type.property-name.less"],
            "settings": {"foreground": "#0a4045"}
        },
        {
            "name": "Preprocessor directives",
            "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive"],
            "settings": {"foreground": "#6e066e"}
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": {"foreground": "#0000b2", "fontStyle": "bold"}
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link", "constant.other.reference.link"],
            "settings": {"foreground": "#0000b2"}
        },
        {
            "name": "Markdown code",
            "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown", "markup.raw.block"],
            "settings": {"foreground": "#0a4045"}
        },
        {
            "name": "Markdown emphasis",
            "scope": ["markup.italic"],
            "settings": {"fontStyle": "italic"}
        },
        {
            "name": "Markdown strong emphasis",
            "scope": ["markup.bold"],
            "settings": {"fontStyle": "bold"}
        },
        {
            "name": "Markdown strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": {"fontStyle": "strikethrough"}
        },
        {
            "name": "Diff additions",
            "scope": ["markup.inserted"],
            "settings": {"foreground": "#0a5c07"}
        },
        {
            "name": "Diff deletions and invalid syntax",
            "scope": ["markup.deleted", "invalid"],
            "settings": {"foreground": "#b60000"}
        },
        {
            "name": "Diff changes",
            "scope": ["markup.changed"],
            "settings": {"foreground": "#0000b2"}
        }
    ],
    "semanticTokenColors": {
        "comment": {"foreground": "#5c5c5c", "italic": true},
        "keyword": "#0000b2",
        "modifier": "#0000b2",
        "operator": "#000000",
        "string": "#0a5c07",
        "regexp": "#0a5c07",
        "number": "#6e066e",
        "type": "#6e066e",
        "class": "#6e066e",
        "interface": "#6e066e",
        "struct": "#6e066e",
        "enum": "#6e066e",
        "typeParameter": "#6e066e",
        "namespace": "#6e066e",
        "decorator": "#6e066e",
        "function": "#0a4045",
        "method": "#0a4045",
        "macro": "#6e066e",
        "variable": "#000000",
        "parameter": "#000000",
        "property": "#000000",
        "enumMember": "#6e066e",
        "variable.readonly": "#6e066e",
        "property.readonly": "#6e066e"
    }
}
